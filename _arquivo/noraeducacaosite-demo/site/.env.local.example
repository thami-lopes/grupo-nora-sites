# Credenciais do Mercado Pago (Checkout Pro)
# Pegue as suas em: https://www.mercadopago.com.br/developers/panel/app
# Use as credenciais de TESTE enquanto valida o fluxo; troque pelas de
# PRODUÇÃO somente quando for cobrar de verdade.
#
# IMPORTANTE: MP_ACCESS_TOKEN é secreto — fica só no servidor (nunca leva o
# prefixo NEXT_PUBLIC_ e nunca deve ser exposto no navegador).
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# URL pública do site (usada para montar os links de retorno do pagamento).
# Em produção, defina para o domínio real, ex: https://educacao.gruponora.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3005
